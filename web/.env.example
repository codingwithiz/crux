# Crux environment. Copy to .env.local and fill in what you need.
# Nothing here is required to boot: with no Supabase vars the app runs
# single-user out of localStorage, and each provider is optional on its own.

# --- Model providers (server-side only; users never supply keys) ---
# At least one is needed for anything to generate. OpenAI is the default.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Local models. Only read on the server — never accepted from a request body,
# since that would let a caller point this server at an arbitrary URL.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Supabase (cloud mode: accounts, the ledger, saved carousels) ---
# Set all three together. Omit them to stay in localStorage-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server-only, used by the daily radar cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ---
# Vercel sends this as `Authorization: Bearer $CRON_SECRET`. Required:
# /api/cron/radar refuses to run when it is unset rather than sitting open.
CRON_SECRET=

# --- Eval harness (dev-only, POST /api/eval) ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.5
